---
/** The app's name and the dumbbell of its icon (src/components/ui/logo.tsx), for the blue band. */
---

<a class="brand" href="/">
  <svg class="logo" viewBox="14 14 80 80" aria-hidden="true">
    <g transform="rotate(-35 54 54)">
      <rect x="38" y="50" width="32" height="8" fill="#fff"></rect>
      <rect x="28" y="36" width="10" height="36" rx="3" fill="#fff"></rect>
      <rect x="70" y="36" width="10" height="36" rx="3" fill="#fff"></rect>
      <rect x="21" y="43" width="7" height="22" rx="3" fill="var(--primary-edge)"></rect>
      <rect x="80" y="43" width="7" height="22" rx="3" fill="var(--primary-edge)"></rect>
    </g>
  </svg>Repso
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font: 800 26px/1 Baloo2, sans-serif;
  }
  .logo {
    width: 34px;
    height: 34px;
  }
</style>
